{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the app's own window may use: its own commands and listening to events, nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-change-password",
    "allow-vault-reset",
    "allow-files-errors",
    "allow-files-reset",
    "allow-profiles-list",
    "allow-profiles-save",
    "allow-profiles-remove",
    "allow-profiles-has-password",
    "allow-profiles-forget-password",
    "allow-profiles-reachable",
    "allow-snippets-list",
    "allow-snippets-save",
    "allow-snippets-remove",
    "allow-snippets-export",
    "allow-snippets-import",
    "allow-keys-list",
    "allow-keys-generate",
    "allow-keys-import",
    "allow-keys-remove",
    "allow-keys-read-file",
    "allow-known-hosts-list",
    "allow-known-hosts-remove",
    "allow-settings-get",
    "allow-settings-save",
    "allow-sync-status",
    "allow-sync-register",
    "allow-sync-login",
    "allow-sync-logout",
    "allow-sync-now",
    "allow-sync-change-password",
    "allow-sync-delete-account",
    "allow-session-connect",
    "allow-session-open-local",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-close",
    "allow-prompt-answer",
    "allow-sftp-home",
    "allow-sftp-list",
    "allow-sftp-upload-dialog",
    "allow-sftp-upload-paths",
    "allow-sftp-download",
    "allow-sftp-rename",
    "allow-sftp-remove",
    "allow-sftp-mkdir",
    "allow-updates-check",
    "allow-updates-download",
    "allow-updates-restart",
    "allow-app-open-external",
    "allow-app-confirm",
    "allow-app-read-clipboard"
  ]
}
