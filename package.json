{
  "name": "burrow-client",
  "productName": "Burrow Client",
  "version": "1.1.1",
  "description": "Local-first SSH client",
  "license": "MIT",
  "author": "Zukotuutori",
  "repository": {
    "type": "git",
    "url": "https://github.com/zukotuutori/burrow-client.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build": "tauri build",
    "build:mac": "tauri build --bundles dmg && node scripts/collect-release.mjs",
    "build:linux": "tauri build --bundles appimage && node scripts/collect-release.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "dev:server": "tsx scripts/dev-ssh-server.ts"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
